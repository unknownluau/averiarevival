{
    "name": "svelte-app",
    "version": "1.0.0",
    "scripts": {
        "rm:bundle": "node -e \"try{require('fs').unlinkSync(require('path').join(__dirname, './public/build/bundle.js.map'));}catch{}\"",
        "rm:license": "node -e \"try{require('fs').unlinkSync(require('path').join(__dirname, './public/build/bundle.js.LICENSE.txt'));}catch{}\"",
        "build": "npm run rm:bundle && npm run rm:license && cross-env NODE_ENV=production webpack",
        "dev": "cross-env NODE_ENV=development webpack --watch",
        "analyze": "cross-env NODE_ENV=production ANALYZE=true webpack",
        "validate": "svelte-check"
    },
    "devDependencies": {
        "@tsconfig/svelte": "^1.0.13",
        "@types/chart.js": "^2.9.41",
        "@types/node": "^14.18.63",
        "cross-env": "^7.0.3",
        "css-loader": "^5.2.7",
        "eslint-loader": "^4.0.2",
        "mini-css-extract-plugin": "^1.6.2",
        "purgecss-webpack-plugin": "^4.1.3",
        "svelte": "^3.59.2",
        "svelte-check": "^1.6.0",
        "svelte-feather-icons": "^3.6.0",
        "svelte-loader": "^3.2.4",
        "svelte-preprocess": "^4.10.7",
        "ts-loader": "^8.4.0",
        "tslib": "^2.8.1",
        "typescript": "^4.9.5",
        "webpack": "^5.108.4",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^4.15.2"
    },
    "dependencies": {
        "@types/bootstrap": "^5.2.11",
        "@types/lodash": "^4.17.24",
        "axios": "^1.18.1",
        "bootstrap": "^5.3.8",
        "chart.js": "^2.9.4",
        "dayjs": "^1.11.21",
        "glob": "^7.2.3",
        "lodash": "^4.18.1",
        "svelte-routing": "^1.11.0"
    }
}
